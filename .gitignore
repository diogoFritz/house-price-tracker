# Ambiente virtual
.venv/
__pycache__
.ipynb_checkpoints/
*.log

# Segredos locais (API keys, credenciais de proxy) — nunca commitar
.env
/sapo/html/*
/imovirtual/html/*
# ...exceto um exemplo de página por site, mantido para consultar o schema/estrutura
!/sapo/html/exemplo_pagina.html
!/imovirtual/html/exemplo_pagina.html

# Checkpoints por página da extração (redundantes com o JSON consolidado) —
# servem só para retomar uma extração interrompida sem repetir pedidos já feitos.
/imovirtual/json/*/
/remax/json/*/
/century21/json/*/

/idealista/html/*
!/idealista/html/exemplo_pagina.html
